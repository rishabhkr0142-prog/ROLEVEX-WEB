# ─────────────────────────────────────────────────────────────
# ROLEVEX — environment variables
# Copy this file to .env.local for local development.
# ─────────────────────────────────────────────────────────────

# Discord application credentials (Discord Developer Portal → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot token — used SERVER-SIDE ONLY to check guilds / roles / users.
# Never exposed to the browser.
DISCORD_BOT_TOKEN=

# SAME MongoDB database as the ROLEVEX bot.
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/rolevex

# Owner detection is ONLY done from these .env lists (comma separated Discord IDs).
# BOT_OWNER_IDS = full control (bot + website owners).
# WEBSITE_OWNER_IDS = website owner tools only (e.g. /owner/noprefix).
BOT_OWNER_IDS=111111111111111111,222222222222222222
WEBSITE_OWNER_IDS=333333333333333333,444444444444444444

# Base URL of this website (no trailing slash).
# Local:  http://localhost:3000
# Prod:   https://rolevex.vercel.app
NEXTAUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# NextAuth encryption secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Bot invite link shown on the Home page and next to servers the bot has not joined.
BOT_INVITE_URL=

# Support server / contact link shown in the footer.
SUPPORT_URL=
